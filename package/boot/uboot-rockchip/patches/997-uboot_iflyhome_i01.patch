+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * (C) Copyright 2018-2019 Rockchip Electronics Co., Ltd
+ */
+
+#include "rk3328-u-boot.dtsi"
+#include "rk3328-sdram-ddr3-666.dtsi"
+
+/ {
+	smbios {
+		compatible = "u-boot,sysinfo-smbios";
+
+		smbios {
+			system {
+				manufacturer = "iFLYTEK";
+				product = "iflyhome-i01_rk3328";
+			};
+
+			baseboard {
+				manufacturer = "iFLYTEK";
+				product = "iflyhome-i01_rk3328";
+			};
+
+			chassis {
+				manufacturer = "iFLYTEK";
+				product = "iflyhome-i01_rk3328";
+			};
+		};
+	};
+};
+
+&spi0 {
+	flash@0 {
+		bootph-pre-ram;
+		bootph-some-ram;
+	};
+};
+
+&spi0m2_clk {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&spi0m2_cs0 {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&spi0m2_rx {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&spi0m2_tx {
+	bootph-pre-ram;
+	bootph-some-ram;
+};
+
+&usb20_otg {
+	hnp-srp-disable;
+};
+
+&uart1 {
+    bootph-all;
+    clock-frequency = <75000000>;
+};
+
+&uart1_xfer {
+    bootph-pre-sram;
+    bootph-pre-ram;
+};
