part uuid ${devtype} ${devnum}:2 uuid

setenv bootargs "console=ttyS1,115200 console=tty1 earlycon=uart8250,mmio32,0xff120000 root=PARTUUID=${uuid} rw rootwait cma=128m";
setenv stdin "serial,usbkbd"
setenv stdout "serial,vidconsole"
setenv stderr "serial,vidconsole"
setenv preboot "usb start"

load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img

bootm ${kernel_addr_r}
